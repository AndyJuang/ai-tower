{
  "_doc": "Copy to config.json (install.sh does this) and edit. Paths may start with ~ and use {baseDir} / {logsDir}. config.json and data/ are gitignored.",
  "port": 4777,
  "baseDir": "~/projects",
  "logsDir": "{baseDir}/_agent-logs",
  "runnerScript": "runner.sh",
  "logPattern": "{line}.log",
  "promptPattern": "{line}-prompt.md",
  "detachOutPattern": "{line}-detach.out",
  "worktreePattern": "{baseDir}/my-app-wt-{line}",
  "mainCheckout": "{baseDir}/my-app",
  "detachScript": "detach.py",
  "queueScripts": [],
  "extraRunners": [],
  "goodDayHideHours": 6,
  "starbaseDir": "{logsDir}/starbase/agents",
  "starbaseAgents": [
    { "name": "沃茲", "role": "桌面 App", "vehicle": "starship" },
    { "name": "克雷格", "role": "iPhone/iPad App", "vehicle": "falcon9" },
    { "name": "強尼", "role": "設計", "vehicle": "mcgregor" }
  ],
  "starbase": {
    "desktopAgent": "沃茲"
  },
  "manualIssueRegex": "manual|實機",
  "manualSectionTitle": "需要實機 · 手動測試",
  "issueRepos": [
    "your-name/my-app"
  ],
  "dispatchRepo": "your-name/my-app",
  "products": {
    "your-name/my-app": { "name": "My App", "short": "MA", "color": "#8a3b12" },
    "your-name/my-docs": { "name": "My Docs", "short": "MD", "color": "#6b3fa0" }
  },
  "primaryProduct": "MA",
  "repos": {
    "your-name/my-docs": { "clone": "{baseDir}/my-docs", "baseBranches": ["main"], "fullTestsCmd": "npm test" }
  },
  "promptTemplateOther": "prompt-template.example.md",
  "worktreeVar": "WT",
  "baseBranches": [
    "main"
  ],
  "titlesFile": "data/titles.json",
  "promptTemplate": "prompt-template.example.md",
  "fullTestsCmd": "npm test",
  "globalCap": 8,
  "lanes": {
    "GK": {
      "cap": 6,
      "auto": true
    },
    "CL": {
      "cap": 2,
      "auto": false
    },
    "CX": {
      "cap": 2,
      "auto": false
    },
    "AG": {
      "cap": 2,
      "auto": false
    }
  },
  "landedKeepMin": 30,
  "demo": false,
  "tzLabel": "",
  "cutoffHour": 8,
  "doneRegex": "READY TO MERGE|可整合"
}